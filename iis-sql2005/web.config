<?xml version="1.0" encoding="utf-8"?>
<!-- Celtics roster on IIS 7.5 (app pool "Celtics", .NET 2.0/3.5, integrated pipeline).
     The app pool identity (IIS APPPOOL\Celtics) has read-only access to roster_db - no password here. -->
<configuration>
  <connectionStrings>
    <add name="roster" connectionString="Data Source=localhost;Initial Catalog=roster_db;Integrated Security=SSPI;Application Name=CelticsWeb" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="false">
      <assemblies>
        <add assembly="System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
      </assemblies>
    </compilation>
    <customErrors mode="RemoteOnly" />
    <httpRuntime enableVersionHeader="false" />
  </system.web>
  <system.webServer>
    <handlers>
      <add name="ApiRoster" path="api/roster" verb="GET" type="Celtics.RosterHandler" resourceType="Unspecified" preCondition="integratedMode" />
      <add name="ApiMvp" path="api/mvp" verb="GET" type="Celtics.MvpHandler" resourceType="Unspecified" preCondition="integratedMode" />
      <add name="ApiSchedule" path="api/schedule" verb="GET" type="Celtics.ScheduleHandler" resourceType="Unspecified" preCondition="integratedMode" />
      <add name="ApiHealth" path="api/health" verb="GET" type="Celtics.HealthHandler" resourceType="Unspecified" preCondition="integratedMode" />
    </handlers>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
